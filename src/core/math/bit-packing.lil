export object BitPacking {
  int set(int storage, int value, int shift, int mask = 1) {
    // LilScript has no unary `~`; XOR with -1 is the same i32 complement.
    int data = storage & ((mask << shift) ^ -1);
    return data | (value << shift);
  }

  int get(int storage, int shift, int mask = 1) {
    return (storage >> shift) & mask;
  }

  bool all(int storage, int shift, int mask = 1) {
    int shifted = mask << shift;
    return (storage & shifted) == shifted;
  }

  bool any(int storage, int shift, int mask = 1) {
    return (storage & (mask << shift)) != 0;
  }
}
