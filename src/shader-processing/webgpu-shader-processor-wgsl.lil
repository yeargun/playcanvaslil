extern UniformBindingFormatHost newUniformBinding(string name, int visibility);
extern TextureFormatHost newTextureBinding(string name, int visibility, string dimension, int sampleType, bool hasSampler, string? samplerName, bool multisampled);
extern StorageBufferFormatHost newStorageBufferBinding(string name, int visibility, bool readOnly);
extern StorageTextureFormatHost newStorageTextureBinding(string name, int format, string dimension, bool write, bool read);
