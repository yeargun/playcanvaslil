extern void appendMatch(JsValue target, JsValue regexMatch);
extern void assertPc(bool condition, string message);
extern void assertPcContext(bool condition, string message, JsValue context);
extern void debugCall(func()->void callback);
extern void errorPc(string message, JsValue context);
extern void warnPc(string message, JsValue context);
extern string[] gpuTextureFormats;
extern Record<int> semanticToLocation;
extern Map<string, int> uniformTypeToNameMapWGSL;
